#!/bin/bash

set -euo pipefail
trap 'exit 1' INT

BUILD=0
CLEAN=0
CHECK=0

# --check モード用の状態（内部運用issue参照）。通常起動時は常に0のままで、
# guard_fail/guard_warn は従来どおり stderr 出力＋exit 1（fail-closed）として振る舞う。
CHECK_MODE=0
CHECK_HAS_ERROR=0
CHECK_HAS_WARN=0

# launcher が設定から選ぶ固定 Compose override の -f 引数列（compose.ipv6.yml・
# compose.plugins-alias.yml）。guard_ipv6()・guard_plugins_alias() が += で積み、
# dispatch の build と run の両方へ同じ配列を渡す（片方だけだと -b の build と直後の
# run で構成が食い違う）。--check は check_one_project() の冒頭でプロジェクトごとに
# リセットする。任意の podman 引数は受け付けない。
COMPOSE_OVERRIDE_ARGS=()

# fail-closed 終端の共通化。通常起動: 従来と同一（stderr へ全行出力し exit 1）。
# --check: 出力して記録し return 1（呼び出し元はそこで打ち切り、ドライバは次のガードへ進む）。
guard_fail() {
  printf '%s\n' "$@" >&2
  if [[ $CHECK_MODE -eq 1 ]]; then
    CHECK_HAS_ERROR=1
    return 1
  fi
  exit 1
}

# WARNING の共通化。通常起動: 従来どおり stderr 出力のみ。--check: 集計に反映。
guard_warn() {
  printf '%s\n' "$@" >&2
  [[ $CHECK_MODE -eq 1 ]] && CHECK_HAS_WARN=1
  return 0
}

usage() {
  cat <<EOF
使い方: $(basename "$0") [オプション] <ディレクトリ>

指定したディレクトリを作業ディレクトリにして、コンテナ化した Claude Code を起動する。

オプション:
  -b, --build          コンテナイメージを強制的に再ビルドしてから起動する
  --clean <ディレクトリ>
                        そのプロジェクト分のイメージ・ネットワーク・
                        ステージング済みビルドコンテキストを削除して終了する
                        削除済みのディレクトリも、起動台帳に同じ絶対パスがあれば対象にできる
  --clean              （ディレクトリなし）全プロジェクト分のイメージ・
                        ネットワーク・ビルドコンテキストを削除して終了する
  --check [<ディレクトリ>...]
                        起動せずに診断する: 再ビルド・起動に必要な対応
                        （レガシー変数、SECRETS_DIR のレイアウト、MCP の承認状態
                        など）を、指定したディレクトリについて、指定がなければ
                        起動台帳（~/.local/state/claude-container/projects）の
                        全プロジェクトについて報告する。非対話で、書き込みはしない。
                        FAIL のプロジェクトが 1 つでもあれば終了コードは非 0。
                        --check と併用した -b は無視される。
  -h, --help            このヘルプを表示して終了する
EOF
}

# 引数を解析する
POSITIONAL_ARGS=()
while [[ $# -gt 0 ]]; do
  case $1 in
    -b|--build)
      BUILD=1
      shift
      ;;
    --clean)
      CLEAN=1
      shift
      ;;
    --check)
      CHECK=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      POSITIONAL_ARGS+=("$1")
      shift
      ;;
  esac
done
# -b の有無は引数解析で確定する。env からの上書き（BUILD=0）で利用者の -b が
# 黙って無効化されるのを防ぐ（claude-container#39）
readonly BUILD

RUN_DIR="$( cd "$(dirname "$( readlink "$0" || ls -1 "$0" )")" > /dev/null && pwd -P )"
# readonly は代入と別文にする（readonly VAR="$( ... )" はコマンド置換の失敗を握り潰し、
# set -e にも if ! にも伝わらないため fail-closed が無言で壊れる。claude-container#39）
readonly RUN_DIR

# 起動台帳（内部運用issue参照）。通常起動のたびにホスト絶対パスを記録し、
# --check（引数なし）で全ファミリープロジェクトを一括診断できるようにする。
# MCP_APPROVAL_STORE と同じ流儀で $HOME から直接算出し、readonly でプロジェクト側 env
# からの上書きを封じる（claude-container#39。呼び出し順序だけでは env の直接代入を防げない）。
CC_STATE_DIR="$HOME/.local/state/claude-container"
CC_LEDGER_FILE="$CC_STATE_DIR/projects"
readonly CC_STATE_DIR CC_LEDGER_FILE

# ============================================================
# 関数定義セクション（--check の dispatch がこれらより後にあるよう、
# すべての関数をトップレベル実行文（下の dispatch セクション）より前に集約する）
# ============================================================

# 実在するプロジェクトイメージ（localhost/<project>_claude-auth-workspace）から
# <project> を逆算し、イメージ・ネットワーク・ビルドコンテキストをまとめて削除する。
# レガシー共有イメージ localhost/claude-container_claude-auth-workspace もこの
# パターンに自然にマッチするため、移行用の特別処理は不要。
clean_all() {
  local repo project found=0
  while IFS= read -r repo; do
    [[ -n "$repo" ]] || continue
    found=1
    project="${repo#localhost/}"
    project="${project%_claude-auth-workspace}"
    echo "イメージを削除します: $repo"
    podman rmi "$repo" 2>/dev/null && echo "削除しました。" || echo "失敗したのでスキップします。"
    echo "ネットワークを削除します: ${project}_default"
    podman network rm "${project}_default" 2>/dev/null && echo "削除しました。" || echo "ネットワークがないのでスキップします。"
  done < <(podman images --format '{{.Repository}}' 2>/dev/null | grep -E '^localhost/.+_claude-auth-workspace$' || true)
  [[ $found -eq 1 ]] || echo "claude-container のイメージが見つからないため、イメージ・ネットワークの削除をスキップします。"
  echo "ステージング済みビルドコンテキストを削除します: $RUN_DIR/.build-context"
  rm -rf "$RUN_DIR/.build-context" && echo "削除しました。" || echo "見つからないのでスキップします。"
  local approval_store="$HOME/.local/state/claude-container/mcp-approvals"
  echo "MCP 承認記録を削除します: $approval_store"
  rm -rf "$approval_store" && echo "削除しました。" || echo "見つからないのでスキップします。"
  echo "起動台帳を削除します: $CC_LEDGER_FILE"
  rm -f "$CC_LEDGER_FILE" && echo "削除しました。" || echo "見つからないのでスキップします。"
  echo "dangling イメージを整理しています..."
  podman image prune -f
}

# 現在のターゲットプロジェクト（$IMAGE_NAME / $PROJECT_NAME / $BUILD_CONTEXT_DIR）分のみを削除する。
clean_project() {
  echo "イメージを削除します: $IMAGE_NAME"
  podman rmi "$IMAGE_NAME" 2>/dev/null && echo "削除しました。" || echo "イメージがないのでスキップします。"
  echo "ネットワークを削除します: ${PROJECT_NAME}_default"
  podman network rm "${PROJECT_NAME}_default" 2>/dev/null && echo "削除しました。" || echo "ネットワークがないのでスキップします。"
  echo "ステージング済みビルドコンテキストを削除します: $BUILD_CONTEXT_DIR"
  rm -rf "$BUILD_CONTEXT_DIR" && echo "削除しました。" || echo "見つからないのでスキップします。"
  echo "MCP 承認記録を削除します: $MCP_APPROVAL_RECORD"
  rm -f "$MCP_APPROVAL_RECORD" && echo "削除しました。" || echo "見つからないのでスキップします。"
  if [[ -f "$CC_LEDGER_FILE" ]]; then
    echo "起動台帳から $WORKING_DIR を削除します: $CC_LEDGER_FILE"
    # 一時台帳は毎回別名・生成時から所有者のみ。旧版の固定 .tmp は再利用しない。
    # trap はこのサブシェルだけに閉じ、失敗時も今回作ったファイルだけを後始末する。
    # || の左側では errexit に頼れないため、失敗する処理は個別に確認する。
    (
      umask 077
      ledger_tmp=$(mktemp "$CC_LEDGER_FILE.tmp.XXXXXX") || {
        echo "ERROR: 起動台帳の一時ファイルを作成できません。元の台帳は変更していません: $CC_LEDGER_FILE" >&2
        exit 1
      }
      trap 'if ! rm -f -- "$ledger_tmp"; then echo "WARNING: 起動台帳の一時ファイルを削除できません: $ledger_tmp" >&2; fi' EXIT
      if ! chmod 600 "$ledger_tmp"; then
        echo "ERROR: 起動台帳の一時ファイルの権限を600に設定できません。元の台帳は変更していません: $CC_LEDGER_FILE" >&2
        exit 1
      fi
      # 出力を開く失敗（rc1）を grep の「残す行なし」と混同しない。
      if ! exec {ledger_fd}> "$ledger_tmp"; then
        echo "ERROR: 起動台帳の一時ファイルを書き込み用に開けません。元の台帳は変更していません: $CC_LEDGER_FILE" >&2
        exit 1
      fi
      # grep の1は残す行なしの正常系。2以上の読み取り・書き込み失敗は区別する。
      if grep -vxF -- "$WORKING_DIR" "$CC_LEDGER_FILE" >&"$ledger_fd"; then
        :
      else
        grep_status=$?
        if [[ $grep_status -ne 1 ]]; then
          echo "ERROR: 起動台帳を更新できません（grep 終了コード $grep_status）。元の台帳は変更していません: $CC_LEDGER_FILE" >&2
          exit 1
        fi
      fi
      if ! mv -- "$ledger_tmp" "$CC_LEDGER_FILE"; then
        echo "ERROR: 起動台帳を置き換えられません: $CC_LEDGER_FILE" >&2
        exit 1
      fi
    ) || return 1
  fi
  echo "dangling イメージを整理しています..."
  podman image prune -f
}

# 通常は cd + pwd の論理パスで識別する（symlink の綴りを保持する）。削除済みの
# --clean だけは台帳の完全一致を条件に同じ識別を復元する。実体パスへ変換すると
# symlink 経由で起動したプロジェクトとは別のハッシュになるため、realpath -ms を使う。
# 相対引数は論理 cwd に連結してから正規化する（realpath に直接渡すと物理 cwd になる）。
resolve_project_directory() {
  local input="$1" candidate
  if [[ -z "$input" ]]; then
    guard_fail "ERROR: ディレクトリに空文字は指定できません。対象のパスを指定してください。"
  fi
  if WORKING_DIR=$(cd -- "$input" >/dev/null 2>&1 && pwd -L); then
    return 0
  fi
  if [[ $CLEAN -eq 1 && ! -e "$input" ]]; then
    candidate="$input"
    [[ "$candidate" == /* ]] || candidate="$(pwd -L)/$candidate"
    # 台帳は1行1パス。改行を grep の複数パターンとして解釈させない。
    if [[ "$candidate" != *$'\n'* ]] && candidate=$(realpath -ms -- "$candidate" 2>/dev/null) \
        && [[ -f "$CC_LEDGER_FILE" ]] && grep -xF -- "$candidate" "$CC_LEDGER_FILE" >/dev/null; then
      WORKING_DIR="$candidate"
      echo "INFO: 削除済みディレクトリを起動台帳のパスで清掃します: $WORKING_DIR"
      return 0
    fi
    guard_fail "ERROR: ディレクトリが存在せず、起動台帳で対象を確認できません: $input" \
      "起動時と同じパスを指定してください（台帳: $CC_LEDGER_FILE）。"
  fi
  guard_fail "ERROR: ディレクトリを開けません: $input" \
    "パスが存在するディレクトリか、アクセス権があるかを確認してください。"
}

# ターゲットプロジェクトごとにイメージ名・ビルドコンテキストを分離するためのキー。
# サニタイズ済み basename + 絶対パスの sha256 先頭8文字（衝突回避）。同名だが別パスの
# プロジェクト同士がイメージ・ビルドコンテキストを共有してしまう事故を、可読性より
# 安全性を優先して防ぐ。
compute_project_name() {
  local base hash
  base=$(basename "$WORKING_DIR" | tr '[:upper:]' '[:lower:]')
  base=$(printf '%s' "$base" | LC_ALL=C sed -E 's/[^a-z0-9_-]+/-/g; s/^-+//; s/-+$//')
  base=${base:0:40}
  [[ -n "$base" ]] || base="project"
  hash=$(printf '%s' "$WORKING_DIR" | sha256sum | cut -c1-8)
  PROJECT_NAME="${base}-${hash}"
  IMAGE_NAME="localhost/${PROJECT_NAME}_claude-auth-workspace"
  readonly PROJECT_NAME IMAGE_NAME
}

# プロジェクトごとの固定パス群（MCP承認記録・設定ディレクトリ・ビルドコンテキスト）を
# freeze する。load_env_file() より前に呼んだうえで readonly にすることで、プロジェクト側の
# .claude-container.d/env が同名キーを直接書いても readonly で拒否され、HOME 等は許可リスト外で
# export されない（claude-container#39、#44）ため、これらのパスは一切影響を受けない。
# --check モード（内部運用issue参照）でプロジェクトごとに再算出するため関数化（readonly は
# ( check_one_project ) サブシェル内に閉じるためプロジェクト間で衝突しない）。
freeze_project_paths() {
  # MCP監査ゲートのTOFU承認記録の格納パス（claude-container#28）。
  MCP_APPROVAL_STORE="$HOME/.local/state/claude-container/mcp-approvals"
  MCP_APPROVAL_RECORD="$MCP_APPROVAL_STORE/$PROJECT_NAME"
  # プロジェクト側の apt/pip パッケージ上書き設定ディレクトリ
  PROJECT_CONF_DIR="$WORKING_DIR/.claude-container.d"
  # ビルドコンテキストのステージング先。プロジェクトごとに分離しつつ、mktemp のような
  # ランダムパスは使わず固定パスにすることで、ビルドキャッシュを安定させ、trap による
  # クリーンアップも不要にする。
  BUILD_CONTEXT_DIR="$RUN_DIR/.build-context/$PROJECT_NAME"
  readonly MCP_APPROVAL_STORE MCP_APPROVAL_RECORD PROJECT_CONF_DIR BUILD_CONTEXT_DIR
  # compose へはコマンド前置代入でなく export で渡す（readonly 変数への前置代入は
  # 一時上書きでなく代入エラーになり、set -euo pipefail 下で起動が abort する。
  # claude-container#39。compose.yml の context: ${BUILD_CONTEXT_DIR} が環境から解決する）
  export BUILD_CONTEXT_DIR
}

# 起動台帳への記録（内部運用issue参照）。--clean/--check では記録しない。
# fail-closed ガードで停止する起動でも記録する（--check で診断したいのはまさに
# そのプロジェクトのため）。台帳は補助台帳であり、記録失敗は起動を止めない
# （fail-soft）。成功時は無出力（通常起動の出力を変えないため）。
record_project_in_ledger() {
  if ! mkdir -p "$CC_STATE_DIR" 2>/dev/null; then
    echo "WARNING: 起動台帳ディレクトリ $CC_STATE_DIR を作成できません。--check での一括診断に使う起動台帳への記録をスキップします。" >&2
    return 0
  fi
  chmod 700 "$CC_STATE_DIR" 2>/dev/null || true
  if [[ -f "$CC_LEDGER_FILE" ]] && grep -qxF -- "$WORKING_DIR" "$CC_LEDGER_FILE" 2>/dev/null; then
    return 0
  fi
  if ! printf '%s\n' "$WORKING_DIR" >> "$CC_LEDGER_FILE" 2>/dev/null; then
    echo "WARNING: 起動台帳 $CC_LEDGER_FILE に記録できません。" >&2
    return 0
  fi
  chmod 600 "$CC_LEDGER_FILE" 2>/dev/null || true
}

# プロジェクトのランタイム設定ファイル（KEY=VALUE）があれば、許可リストのキーだけを環境変数として
# 取り込む。source だとシェル構文がホスト上で即時解釈され任意コード実行になりうるため、変数代入以外の
# 行は無視する（値は最初の = 以降の生文字列。クォート・展開は解釈しない）。
#
# 許可リスト（claude-container#44）: compose.yml が補間するキーのうちホスト側の実行や基点に
# 影響しないものと、コンテナのモードに使うキー（TZ・CLAUDE_CONTAINER_NO_FIREWALL・CLAUDE_CONTAINER_IPV6）。一方 PATH・HOME・
# LD_PRELOAD・BASH_ENV や podman・git・gh・python3 が読む各種変数は、export されるとホスト側の
# ランチャーやその外部コマンドの挙動を変える（HOME だけで guard_codex_dir の fail-closed が沈黙する
# ことを実測）。拒否リストは列挙が閉じないので、許可リストで受け付けるキーを固定し、それ以外は
# WARNING を出して無視する（export しなければ無害なので ERROR にはしない。--check では [WARN]）。
# 新しいキーを compose.yml へ足したら、この配列と README「環境変数」節の表を同時に更新する
# （両者の一致は test-build.sh の E7 が検査する）。compose.yml が補間するキーでも
# CLAUDE_CODE_VERSION は意図的に除外している — 値は Dockerfile.claude の
# `install.sh | bash -s ${CLAUDE_CODE_VERSION}` へクォートなしで展開され、リポジトリ側から
# 書けるとビルド時 root でのコマンド注入経路になる（claude-container#62）。シェル環境から
# 渡す経路は従来どおり有効。
# 保護変数（readonly）は許可リストに含まれないので上書きされない。readonly 宣言自体は
# スクリプト内部の直接代入に対する防御として残す（claude-container#39）。許可リストのキーを
# readonly にしないこと — 下の export は無条件なので、readonly だと set -euo pipefail 下で
# bash の生エラーのまま起動が落ちる。
# ローカル変数名を _lef_ で名前空間化しているのは、bash の動的スコープにより関数内ローカルと同名の
# キーが export してもグローバルへ出ないため（許可リストのキーをこの名前にしないこと）。
ENV_FILE_ALLOWED_KEYS=(
  CLAUDE_CONFIG_DIR
  EXTRA_MOUNT
  SHARED_MOUNT
  TZ
  CLAUDE_CONTAINER_NO_FIREWALL
  CLAUDE_CONTAINER_IPV6
  GITCONFIG_FILE
  SECRETS_DIR
  CODEX_DIR
)
readonly -a ENV_FILE_ALLOWED_KEYS
load_env_file() {
  local _lef_file="$1" _lef_line _lef_key _lef_ignored=0
  while IFS= read -r _lef_line || [[ -n "$_lef_line" ]]; do
    [[ "$_lef_line" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || continue
    _lef_key="${_lef_line%%=*}"
    if [[ " ${ENV_FILE_ALLOWED_KEYS[*]} " != *" $_lef_key "* ]]; then
      # 受け付けるキーの一覧は行ごとに繰り返さず、末尾で 1 回だけ出す（無関係なキーが数個あると
      # 一覧の反復でログが埋まり、後続の専用ガードの具体的な案内が埋もれるため）。
      guard_warn "WARNING: $_lef_file のキー $_lef_key は claude-container が解釈しないため無視します。"
      _lef_ignored=1
      continue
    fi
    # shellcheck disable=SC2163  # 変数名でなく KEY=VALUE 文字列の export が意図
    export "$_lef_line"
  done < "$_lef_file"
  if [[ $_lef_ignored -eq 1 ]]; then
    guard_warn "  受け付けるキー: ${ENV_FILE_ALLOWED_KEYS[*]}（README「環境変数」節）。ホスト側で使う変数はシェル環境から渡してください。"
  fi
}

# 設定から固定の Compose override を選ぶ。任意の podman 引数は受け付けない。
guard_ipv6() {
  case "${CLAUDE_CONTAINER_IPV6:-0}" in
    ''|0) ;;
    1) COMPOSE_OVERRIDE_ARGS+=(-f "$RUN_DIR/compose.ipv6.yml") ;;
    *) guard_fail "ERROR: CLAUDE_CONTAINER_IPV6 は0または1で指定してください。"; return 1 ;;
  esac
  if [[ "${CHECK_MODE:-0}" == 1 ]]; then
    echo "[OK]   IPv6 設定: ${CLAUDE_CONTAINER_IPV6:-0}"
  fi
  [[ "${CLAUDE_CONTAINER_IPV6:-0}" == 1 ]] || return 0
  # 対応前の entrypoint はモードを無視する。既存イメージを使う場合だけ拒否する。
  [[ "${BUILD:-0}" == 1 && "${CHECK_MODE:-0}" == 0 ]] && return 0
  command -v podman >/dev/null 2>&1 || return 0
  podman image exists "$IMAGE_NAME" 2>/dev/null || return 0
  local support
  support=$(podman image inspect --format '{{index .Labels "claude-container.ipv6-support"}}' "$IMAGE_NAME" 2>/dev/null || true)
  if [[ "$support" != 1 ]]; then
    guard_fail "ERROR: イメージ $IMAGE_NAME は IPv6 対応を確認できません。-b でリビルドしてください。"
    return 1
  fi
  return 0
}

# ランタイム設定に GH_TOKEN を直書きしても、compose.yml の environment: 経由では
# 渡さない設計（トークンを podman inspect に露出させないため）。直書きに気づかず
# 「動かない」で詰まるのを防ぐ誤用ガード。
guard_env_gh_token() {
  if [[ -n "$ENV_FILE" ]] && grep -qE '^GH_TOKEN=' "$ENV_FILE"; then
    guard_warn "WARNING: $ENV_FILE の GH_TOKEN=... はコンテナに渡されません。SECRETS_DIR 配下にトークンファイルを置いてください（README「GitHub トークンの配線」節）。"
  fi
}

# legacy トークン変数（GH_TOKEN_FILE / GH_TOKEN_SECONDARY_FILE）は v4 で撤廃した
# （claude-container#24）。後方互換エイリアスは持たないため、設定されていたら黙って
# 無視せず fail-closed で起動を中止し、新レイアウトへの移行手順を案内する（検出した
# 変数をまとめて1回で提示し、複数回起動してもう1個見つかる体験を避ける）。
guard_legacy_vars() {
  local _legacy_vars_found=() _lv
  # シェル環境の export 済み変数と、env ファイルの行の両方を見る。後者は許可リスト外なので
  # export されず（claude-container#44）、変数を見るだけでは移行案内が汎用 WARNING に格下げされる。
  for _lv in GH_TOKEN_FILE GH_TOKEN_SECONDARY_FILE; do
    if [[ -n "${!_lv:-}" ]] || { [[ -n "$ENV_FILE" ]] && grep -qE "^${_lv}=" "$ENV_FILE" 2>/dev/null; }; then
      _legacy_vars_found+=("$_lv")
    fi
  done
  if [[ ${#_legacy_vars_found[@]} -gt 0 ]]; then
    guard_fail \
      "ERROR: 次の変数は廃止されました（後方互換なし、claude-container#24）: ${_legacy_vars_found[*]}" \
      "移行手順:" \
      "  1. $ENV_FILE（およびシェル環境）から上記変数の行を削除する" \
      "  2. push・PR 用のメイン PAT は SECRETS_DIR 直下に GITHUB_MAIN_PAT として置く（chmod 600）。" \
      "     コンテナ内で export されず、git push（askpass 自動配線）と" \
      "     GH_TOKEN=\$(cat \"\$GITHUB_MAIN_PAT_FILE\") gh ... の明示読みでのみ使う" \
      "  3. Issues/MCP 用 PAT は SECRETS_DIR/export/GITHUB_MCP_PAT として置く（chmod 600。コンテナ内で環境変数として export される）" \
      "  4. $ENV_FILE に SECRETS_DIR=<ディレクトリ> を書く（chmod 700 推奨）" \
      "注意: GH_TOKEN の自動 export は撤廃されました。gh は既定で未認証になります。" \
      "詳細: README.md「GitHub トークンの配線」節。起動を中止します。" || return 1
  fi
}

# ホスト側 git 設定ファイルの参照（GITCONFIG_FILE）。任意設定のため未設定時は何もしない。
# 設定済みでファイルが無い場合のみ起動を中止する（不存在パスを bind mount すると podman が
# ホスト側に空ディレクトリを誤作成し、コンテナ内 ~/.gitconfig もディレクトリになって
# git が壊れるため）。
guard_gitconfig_file() {
  if [[ -n "${GITCONFIG_FILE:-}" ]]; then
    GITCONFIG_FILE="${GITCONFIG_FILE/#\~\//$HOME/}"
    export GITCONFIG_FILE
    if [[ ! -f "$GITCONFIG_FILE" ]]; then
      guard_fail "ERROR: GITCONFIG_FILE=$GITCONFIG_FILE が見つかりません(存在しないか通常ファイルではありません)。起動を中止します。" || return 1
    fi
  fi
}

# 汎用シークレットディレクトリの参照（SECRETS_DIR）。任意設定のため未設定時は何もしない。
# 設計原則（exposure 軸、claude-container#24）: 直下のファイルは export されない
# （メインPAT等の広い権限向け）。export/ サブディレクトリのファイルのみ、コンテナ内で
# 「ファイル名＝環境変数名」として export される（issues 限定PAT等、entrypoint.sh 参照）。
# v3 以前とは直下/export の意味が逆転している。設定済みでディレクトリが無い場合は
# 起動を中止する（GITCONFIG_FILE と同じ理由: 不存在パスを bind mount すると podman が
# ホスト側に空ディレクトリを誤作成するため）。
guard_secrets_dir() {
  if [[ -n "${SECRETS_DIR:-}" ]]; then
    SECRETS_DIR="${SECRETS_DIR/#\~\//$HOME/}"
    export SECRETS_DIR
    if [[ ! -d "$SECRETS_DIR" ]]; then
      guard_fail "ERROR: SECRETS_DIR=$SECRETS_DIR が見つかりません（存在しないかディレクトリではありません）。起動を中止します。" || return 1
    fi
    # v3 以前のレイアウト（noexport/ サブディレクトリ）が残っていたら fail-closed で
    # 停止する。新レイアウトでは直下が非export（旧 noexport/ 相当）になったため、残存
    # させると設計意図が伝わらないまま、あるいは意図せず export 側に倒れるのを防ぐ。
    if [[ -d "$SECRETS_DIR/noexport" ]]; then
      guard_fail \
        "ERROR: $SECRETS_DIR/noexport が見つかりました。v4 で SECRETS_DIR のレイアウトが変わりました（claude-container#24）:" \
        "  旧: 直下=export される / noexport/=export されない" \
        "  新: 直下=export されない / export/=export される" \
        "移行手順: noexport/ 配下のファイルを SECRETS_DIR 直下へ移動し（GIT_PUSH_TOKEN は GITHUB_MAIN_PAT へ改名）、" \
        "  従来 SECRETS_DIR 直下にあった export 用ファイルは export/ サブディレクトリへ移動してください。" \
        "詳細: README.md「GitHub トークンの配線」節。起動を中止します。" || return 1
    fi
    local secrets_dir_perm
    secrets_dir_perm=$(stat -c '%a' "$SECRETS_DIR" 2>/dev/null || stat -f '%Lp' "$SECRETS_DIR" 2>/dev/null || echo "")
    if [[ -n "$secrets_dir_perm" && "$secrets_dir_perm" != "700" ]]; then
      guard_warn "WARNING: SECRETS_DIR=$SECRETS_DIR のパーミッションが $secrets_dir_perm です。chmod 700 を推奨します。"
    fi
    local secret_file secret_file_perm
    for secret_file in "$SECRETS_DIR"/*; do
      [[ -f "$secret_file" ]] || continue
      secret_file_perm=$(stat -c '%a' "$secret_file" 2>/dev/null || stat -f '%Lp' "$secret_file" 2>/dev/null || echo "")
      if [[ -n "$secret_file_perm" && "$secret_file_perm" != "600" ]]; then
        guard_warn "WARNING: SECRETS_DIR 内の $(basename "$secret_file") のパーミッションが $secret_file_perm です。chmod 600 を推奨します。"
      fi
      # 直下は export されない（新レイアウト）。export 前提のファイル名が直下に
      # 置かれていると export/ への移動忘れの可能性が高いため気づけるよう注意喚起する
      # （ブロックはしない — 直下＝非exportは有効な選択でもあるため）。
      if [[ "$(basename "$secret_file")" == "GITHUB_MCP_PAT" ]]; then
        guard_warn "WARNING: SECRETS_DIR/GITHUB_MCP_PAT は直下に置かれているため export されません（v4〜）。MCP・gh CLI から使うには export/GITHUB_MCP_PAT へ移動してください。"
      fi
    done
    # export/ サブディレクトリ（コンテナ内で export されるファイル秘密の規約、
    # README「SECRETS_DIR」節参照）も同じ検証を行う。上のループは [[ -f ]] 判定で
    # サブディレクトリ自体を黙ってスキップするため、ここで個別に確認する。
    if [[ -d "$SECRETS_DIR/export" ]]; then
      local export_dir_perm
      export_dir_perm=$(stat -c '%a' "$SECRETS_DIR/export" 2>/dev/null || stat -f '%Lp' "$SECRETS_DIR/export" 2>/dev/null || echo "")
      if [[ -n "$export_dir_perm" && "$export_dir_perm" != "700" ]]; then
        guard_warn "WARNING: SECRETS_DIR/export のパーミッションが $export_dir_perm です。chmod 700 を推奨します。"
      fi
      for secret_file in "$SECRETS_DIR/export"/*; do
        [[ -f "$secret_file" ]] || continue
        secret_file_perm=$(stat -c '%a' "$secret_file" 2>/dev/null || stat -f '%Lp' "$secret_file" 2>/dev/null || echo "")
        if [[ -n "$secret_file_perm" && "$secret_file_perm" != "600" ]]; then
          guard_warn "WARNING: SECRETS_DIR/export 内の $(basename "$secret_file") のパーミッションが $secret_file_perm です。chmod 600 を推奨します。"
        fi
      done
    fi
  fi
}

# Codex CLI の認証情報ディレクトリの参照（CODEX_DIR）。任意設定のため未設定時は何もしない。
# auth.json はセッション中にトークンが自動リフレッシュされホストへ書き戻される必要があるため
# rw マウント（compose.yml 側で :ro を付けない）。実ホストの ~/.codex を直接指すと、コンテナ側
# コードが config.toml（notify フック・MCPサーバー定義）を汚染し、ホストで codex 起動時に
# 任意コマンドが実行される経路が生じるため、専用ディレクトリ（例: ~/.codex-container）を
# 前提とする（README「利用側プロジェクトの設定」節参照）。設定済みでディレクトリが無い場合は
# 起動を中止する（GITCONFIG_FILE/SECRETS_DIR と同じ理由: 不存在パスを bind mount すると
# podman がホスト側に空ディレクトリを誤作成するため）。詳細は内部運用issue参照。
guard_codex_dir() {
  if [[ -n "${CODEX_DIR:-}" ]]; then
    CODEX_DIR="${CODEX_DIR/#\~\//$HOME/}"
    CODEX_DIR="${CODEX_DIR%/}"
    export CODEX_DIR
    local codex_real_msg="ERROR: CODEX_DIR が実ホストの \$HOME/.codex を指しています。コンテナ側のコードが config.toml（notify フック・MCP サーバー定義）を汚染し、ホストで codex 実行時に任意コマンドが実行される経路になるため、専用ディレクトリ（例: ~/.codex-container）を指定してください。起動を中止します。"
    # 文字列比較（claude-container#36）。~/.codex が存在しない状態での誤指定もここで捕まえる。
    if [[ "$CODEX_DIR" == "$HOME/.codex" ]]; then
      guard_fail "$codex_real_msg" || return 1
    fi
    # 相対パスは拒否する（CLAUDE_CONFIG_DIR と同じ理由: compose は相対 bind source を
    # compose.yml のディレクトリ基準で解決し、ランチャーの解釈と食い違う。加えて相対パスの
    # cd は CDPATH — env から export できる — の影響を受ける）。claude-container#48
    if [[ "$CODEX_DIR" != /* ]]; then
      guard_fail "ERROR: CODEX_DIR=$CODEX_DIR は絶対パス（または ~/ 始まり）で指定してください。起動を中止します。" || return 1
    fi
    if [[ ! -d "$CODEX_DIR" ]]; then
      guard_fail "ERROR: CODEX_DIR=$CODEX_DIR が見つかりません（存在しないかディレクトリではありません）。起動を中止します。" || return 1
    fi
    # 実体で比較する（claude-container#48）。`~/.codex//`・`~/./.codex`・`~/.codex/.`・
    # `//home/...`・実 ~/.codex への symlink は文字列比較をすり抜け、podman 側で解決されて
    # 実 ~/.codex が rw マウントされるため、-ef（同じ device と inode か）で比べる。
    # パス文字列の正規化（pwd -P）では先頭の `//` が残り（POSIX で意味が実装定義のため
    # bash は保持する）、文字列比較に戻ると同じ穴が開く。$HOME/.codex 側が存在しない・
    # 辿れない場合は -ef が偽になるだけで起動は止めず、上の文字列比較だけに委ねる
    # （運用者が指していないディレクトリの事情で止めない）。
    if [[ "$CODEX_DIR" -ef "$HOME/.codex" ]]; then
      guard_fail "$codex_real_msg" || return 1
    fi
    # 正規化済みの絶対パスを compose へ渡す（CLAUDE_CONFIG_DIR と同じ扱い。bind source に
    # `.`・`..`・symlink・先頭 `//` を含めない）。CDPATH='' は cd の検索経路を断ち、
    # >/dev/null は CDPATH 経由時に cd が出力するパスを捨てる。
    local codex_dir_real
    if ! codex_dir_real="$(CDPATH='' cd -- "$CODEX_DIR" >/dev/null 2>&1 && pwd -P)"; then
      guard_fail "ERROR: CODEX_DIR=$CODEX_DIR を解決できません（ディレクトリに入れません）。起動を中止します。" || return 1
    fi
    while [[ "$codex_dir_real" == //* ]]; do codex_dir_real="${codex_dir_real#/}"; done
    CODEX_DIR="$codex_dir_real"
    export CODEX_DIR
    local codex_dir_perm
    codex_dir_perm=$(stat -c '%a' "$CODEX_DIR" 2>/dev/null || stat -f '%Lp' "$CODEX_DIR" 2>/dev/null || echo "")
    if [[ -n "$codex_dir_perm" && "$codex_dir_perm" != "700" ]]; then
      guard_warn "WARNING: CODEX_DIR=$CODEX_DIR のパーミッションが $codex_dir_perm です。chmod 700 を推奨します。"
    fi
    if [[ -f "$CODEX_DIR/auth.json" ]]; then
      local auth_json_perm
      auth_json_perm=$(stat -c '%a' "$CODEX_DIR/auth.json" 2>/dev/null || stat -f '%Lp' "$CODEX_DIR/auth.json" 2>/dev/null || echo "")
      if [[ -n "$auth_json_perm" && "$auth_json_perm" != "600" ]]; then
        guard_warn "WARNING: $CODEX_DIR/auth.json のパーミッションが $auth_json_perm です。chmod 600 を推奨します。"
      fi
    fi
  fi
}

# ホスト ~/.claude のうち「ホスト側で実行・読込される user scope の設定」を、compose.yml が
# rw マウントの内側に :ro で重ねる 11 項目（compose.yml の volumes と test-build.sh の
# CONFIG_RO_DIRS/FILES と同期すること）。侵害されたセッションがここへ hook/skill/plugin 等を
# 書くと、ホストの Claude Code がそれを読み込み・実行する（user settings の hooks は file
# watcher で稼働中セッションにも反映）ため、この経路をマウント層で閉じる。
# 認証（.credentials.json）・transcript・memory 等の状態は対象外（rw のまま）。
CLAUDE_CONFIG_RO_DIRS=(hooks skills plugins commands agents workflows rules output-styles)
CLAUDE_CONFIG_RO_FILES=(settings.json CLAUDE.md statusline.sh)

# 上記 11 項目のマウント先をホスト側に用意する。マウント先が無いと podman がサブ uid
# 所有・0700 の実体をホストの ~/.claude 内に作り、ユーザー権限で消せない残骸になるため、
# ランチャーがユーザー権限で明示的に空で作る（空ディレクトリ・空ファイル・`{}` は
# Claude Code にとって不活性）。基点は compose.yml の親マウントと同じ ${CLAUDE_CONFIG_DIR:-~}。
# 呼び出し位置は全 guard と MCP 承認の後（起動を拒否する経路ではホストに何も書かない）。
# --check（CHECK_MODE=1）では何も作らず報告だけ行う（--check は書き込みをしない契約）。
prepare_claude_config_ro() {
  local base cfg name path created=0 host_base
  # plugin 別名（guard_plugins_alias()、claude-container#98）用に、基点の「~ 展開済み・
  # 実体未解決」の綴りを残す。plugin のメタデータはホストの Claude Code が見た綴りを
  # 記録するため、下の pwd -P で実体解決した値では symlink 経由の HOME と食い違う。
  # 基点の検証に失敗した経路では空のまま（別名の判定を行わない）。
  CLAUDE_CONFIG_HOST_BASE=""
  if [[ -n "${CLAUDE_CONFIG_DIR:-}" ]]; then
    base="${CLAUDE_CONFIG_DIR}"
    [[ "$base" == "~" ]] && base="$HOME"
    base="${base/#\~\//$HOME/}"
    host_base="$base"
    # 相対パスは拒否する。compose は相対 bind source を compose.yml のディレクトリ基準で
    # 解決し、ランチャーの解釈と食い違って親マウントと 11 項目が別実体を指しうるため。
    if [[ "$base" != /* ]]; then
      guard_fail "ERROR: CLAUDE_CONFIG_DIR=$CLAUDE_CONFIG_DIR は絶対パス（または ~/ 始まり）で指定してください。起動を中止します。" || return 1
    fi
    if [[ ! -d "$base" ]]; then
      guard_fail "ERROR: CLAUDE_CONFIG_DIR=$base が見つかりません（存在しないかディレクトリではありません）。起動を中止します。" || return 1
    fi
    if ! base="$(cd "$base" 2>/dev/null && pwd -P)"; then
      guard_fail "ERROR: CLAUDE_CONFIG_DIR=$base を解決できません（ディレクトリに入れません）。起動を中止します。" || return 1
    fi
    # 親マウント（compose.yml の ${CLAUDE_CONFIG_DIR:-~}/.claude）と同じ実体を指すよう、
    # 展開・正規化済みの絶対パスを渡す。
    CLAUDE_CONFIG_DIR="$base"
    export CLAUDE_CONFIG_DIR
    CLAUDE_CONFIG_HOST_BASE="$host_base"
  else
    base="$HOME"
    CLAUDE_CONFIG_HOST_BASE="$HOME"
  fi
  cfg="$base/.claude"

  if [[ ${CHECK_MODE:-0} -eq 1 ]]; then
    echo "[INFO] ~/.claude 読み取り専用保護: $(( ${#CLAUDE_CONFIG_RO_DIRS[@]} + ${#CLAUDE_CONFIG_RO_FILES[@]} )) 項目（基点 $cfg）"
  fi

  if [[ ! -d "$cfg" ]]; then
    if [[ -e "$cfg" || -L "$cfg" ]]; then
      guard_fail "ERROR: $cfg がディレクトリではありません。起動を中止します。" || return 1
    fi
    if [[ ${CHECK_MODE:-0} -eq 1 ]]; then
      guard_warn "[WARN] $cfg が無い（通常起動時に空で作成。11 項目もその際に作成）"
      return 0
    fi
    mkdir -p "$cfg" || { guard_fail "ERROR: $cfg を作成できません。起動を中止します。" || return 1; }
    echo "INFO: $cfg を読み取り専用保護のため空で作成しました" >&2
  fi

  # symlink は有効・無効を問わず拒否する。:ro の子マウントはリンク先に付くが、リンク自体は
  # rw の親マウント内に残るため、コンテナ内で rm + mkdir すれば書き込み可能な実体へ
  # 置き換えられ、保護を迂回できる。実ディレクトリ／実ファイルに置き換えてもらう。
  for name in "${CLAUDE_CONFIG_RO_DIRS[@]}"; do
    path="$cfg/$name"
    if [[ -L "$path" ]]; then
      guard_fail "ERROR: $path が symlink です（読み取り専用保護はコンテナ内から rm + mkdir で迂回されるため、実ディレクトリに置き換えてください）。起動を中止します。" || return 1
    elif [[ -d "$path" ]]; then
      continue
    elif [[ -e "$path" ]]; then
      guard_fail "ERROR: $path がディレクトリではありません（読み取り専用保護のマウント先と型が一致しません）。起動を中止します。" || return 1
    elif [[ ${CHECK_MODE:-0} -eq 1 ]]; then
      guard_warn "[WARN] $path が無い（通常起動時に空で作成）"
    else
      mkdir -p "$path" || { guard_fail "ERROR: $path を作成できません。起動を中止します。" || return 1; }
      echo "INFO: $path を読み取り専用保護のため空で作成しました" >&2
      created=$((created + 1))
    fi
  done
  for name in "${CLAUDE_CONFIG_RO_FILES[@]}"; do
    path="$cfg/$name"
    if [[ -L "$path" ]]; then
      guard_fail "ERROR: $path が symlink です（読み取り専用保護はコンテナ内から rm + 再作成で迂回されるため、実ファイルに置き換えてください）。起動を中止します。" || return 1
    elif [[ -f "$path" ]]; then
      continue
    elif [[ -e "$path" ]]; then
      guard_fail "ERROR: $path が通常ファイルではありません（読み取り専用保護のマウント先と型が一致しません）。起動を中止します。" || return 1
    elif [[ ${CHECK_MODE:-0} -eq 1 ]]; then
      guard_warn "[WARN] $path が無い（通常起動時に空で作成）"
    else
      # noclobber（set -C）で作る: 存在確認と作成の間に別プロセスがファイルを置いた場合に
      # 上書き（切り詰め）せず失敗させる。
      if [[ "$name" == "settings.json" ]]; then
        ( set -C; printf '{}\n' > "$path" ) 2>/dev/null || { guard_fail "ERROR: $path を作成できません（同時に作成された可能性があります。再実行してください）。起動を中止します。" || return 1; }
      else
        ( set -C; : > "$path" ) 2>/dev/null || { guard_fail "ERROR: $path を作成できません（同時に作成された可能性があります。再実行してください）。起動を中止します。" || return 1; }
      fi
      echo "INFO: $path を読み取り専用保護のため空で作成しました" >&2
      created=$((created + 1))
    fi
  done

  # 別の rw マウント（/workspace・/data・/shared）が同じ実体を含んでいれば、:ro 重ねは
  # その経路からは効かない。起動は止めず警告する（運用者が意図して選べる構成のため）。
  # 別の rw マウント（/workspace・/data・/shared）が同じ実体を含む、または同じ実体に含まれる
  # （保護対象そのものを /data に載せる等）場合、:ro 重ねはその経路からは効かない。
  # 起動は止めず警告する（運用者が意図して選べる構成のため）。
  local cfg_real other other_real
  if ! cfg_real="$(cd "$cfg" 2>/dev/null && pwd -P)"; then
    guard_fail "ERROR: $cfg に入れません（パーミッションを確認してください）。起動を中止します。" || return 1
  fi
  for other in "${WORKING_DIR:-}" "${EXTRA_MOUNT:-}" "${SHARED_MOUNT:-}"; do
    [[ -n "$other" ]] || continue
    other="${other/#\~\//$HOME/}"
    [[ -d "$other" ]] || continue
    other_real="$(cd "$other" 2>/dev/null && pwd -P)" || continue
    other_real="${other_real%/}"   # "/" は "" になり、次の "$other_real"/* が "/*" として全パスに一致する
    if [[ "$cfg_real" == "$other_real" || "$cfg_real" == "$other_real"/* || "$other_real" == "$cfg_real"/* ]]; then
      guard_warn "WARNING: $other が $cfg_real を含む（または含まれる）ため、別の rw マウント経由で書けます。~/.claude 設定の読み取り専用保護はこの経路には効きません。"
    fi
  done
  return 0
}

# plugin 別名マウント（claude-container#98）の destination を判定する。副作用なし（ファイル
# システムにも触れない。存在確認は prepare_claude_config_ro() が済ませている）。
# 引数: $1=基点の綴り（~ 展開済み・実体未解決）、$2=$HOME の綴り。stdout に destination を
# 出力し、終了コードで結果を返す:
#   0 = 別名を付ける（stdout が destination）
#   1 = 別名不要（コンテナ内の /home/node/.claude/plugins と一致し、既存の :ro マウントで足りる）
#   2 = 対応範囲外（stdout は空。メッセージ化は呼び出し元）
# 対応範囲は「基点がホストの $HOME と一致するかその配下」に限る。plugin のメタデータは
# ホストの Claude Code が見た綴りを記録するので、実体パスや別基点の綴りで指定された
# CLAUDE_CONFIG_DIR はメタデータと一致する保証が無い。またコンテナ内の固定マウント先
# （/workspace・/data・/shared・/home/node）と一致または配下の destination は、対象
# プロジェクトや他マウントの内容を隠すため付けない。
# 関数定義は test-build.sh が `sed -n '/^plugins_alias_target()/,/^}/p'` で抽出して単独実行
# する（開始行と終了行の形を変えない。他の関数を呼ばない）。
plugins_alias_target() {
  local base="$1" home="$2" candidate p v fixed
  # 正規化: // を / に圧縮し、末尾の / と /. の連なりを除去する。正規化後も /./ や /..
  # を含む、または絶対パスでなくなる（/ 単体・空）ものは不正（空文字にする）。
  for p in base home; do
    v="${!p}"
    while [[ "$v" == *//* ]]; do v="${v//\/\//\/}"; done
    while [[ "$v" == */. || "$v" == */ ]]; do v="${v%/.}"; v="${v%/}"; done
    [[ "$v" == /* ]] || v=""
    [[ "$v" == */./* || "$v" == */../* || "$v" == */.. ]] && v=""
    printf -v "$p" '%s' "$v"
  done
  # 規則 1: base が正規化できなければ範囲外。
  [[ -n "$base" ]] || return 2
  candidate="$base/.claude/plugins"
  # 規則 2: コンテナ内パスと一致なら別名不要。$HOME の検証（規則 3）より先に判定する
  # （$HOME が不正でも、既存の :ro マウントで足りる状況に誤警告を出さない）。
  [[ "$candidate" == /home/node/.claude/plugins ]] && return 1
  # 規則 3: base が $HOME と一致するかその配下でなければ範囲外。
  [[ -n "$home" ]] || return 2
  [[ "$base" == "$home" || "$base" == "$home"/* ]] || return 2
  # 規則 4: コンテナ内の固定マウント先と一致または配下なら範囲外。
  for fixed in /workspace /data /shared /home/node; do
    [[ "$candidate" == "$fixed" || "$candidate" == "$fixed"/* ]] && return 2
  done
  printf '%s\n' "$candidate"
  return 0
}

# plugin 別名マウント（claude-container#98）。ホストで install した plugin のメタデータ
# （~/.claude/plugins/known_marketplaces.json・installed_plugins.json）はホストの絶対パスを
# 記録しており、コンテナ内（HOME=/home/node）では解決できない。かつて entrypoint.sh が
# JSON をコンテナ内パスへ sed で書き換えていたが、plugins/ を :ro で保護した時点で書けなく
# なった（書けてはいけない）。代わりに、同じ実体をホストと同じ絶対パスにも :ro で重ねる
# 固定 override（compose.plugins-alias.yml）を選ぶ。起動可否には影響しない（範囲外なら
# WARNING を出して plugin が読めないだけ）ため guard_fail は使わない。通常起動と --check の
# 両方で prepare_claude_config_ro() の直後に呼ぶ（plugins/ が存在する前提。--check は
# 変数操作だけで何も作らない）。
guard_plugins_alias() {
  local target rc=0
  # 「別名を付けないなら未 export」を保つ。シェル環境から注入された値は override が選ばれない
  # 限り不活性だが、compose の環境に残さない（.claude-container.d/env は許可リスト外なので
  # 元々通らない）。適用分岐では算出値で上書きする。
  unset CLAUDE_PLUGINS_HOST_PATH
  # 基点の検証に失敗した経路（CLAUDE_CONFIG_HOST_BASE が空）では判定しない。
  [[ -n "${CLAUDE_CONFIG_HOST_BASE:-}" ]] || return 0
  target=$(plugins_alias_target "$CLAUDE_CONFIG_HOST_BASE" "$HOME") || rc=$?
  case "$rc" in
    0)
      export CLAUDE_PLUGINS_HOST_PATH="$target"
      COMPOSE_OVERRIDE_ARGS+=(-f "$RUN_DIR/compose.plugins-alias.yml")
      [[ "${CHECK_MODE:-0}" == 1 ]] && echo "[OK]   plugin 別名: $target"
      ;;
    1)
      [[ "${CHECK_MODE:-0}" == 1 ]] && echo "[INFO] plugin 別名: 不要（コンテナ内パスと一致）"
      ;;
    *)
      guard_warn "WARNING: ホストの plugins/ の綴り ${CLAUDE_CONFIG_HOST_BASE}/.claude/plugins はコンテナ内で別名にできません（基点が \$HOME の配下でないか、コンテナ内の固定マウント先 /workspace・/data・/shared・/home/node と重なります）。ホストで install した plugin はコンテナ内で読み込めません。"
      ;;
  esac
  return 0
}

# 第2の追加マウント（SHARED_MOUNT）の参照。任意設定のため未設定時は何もしない。
# 複数プロジェクトから同一ホストディレクトリ（共有ノート置き場等）を固定名 /shared で
# 参照するための opt-in（claude-container#46）。EXTRA_MOUNT（/data）と独立したスロット。
# 秘密情報を置く前提のディレクトリではないためパーミッション警告は行わない（EXTRA_MOUNT と
# 同様）。設定済みでディレクトリが無い場合は起動を中止する（GITCONFIG_FILE/SECRETS_DIR/
# CODEX_DIR と同じ理由: 不存在パスを bind mount すると podman がホスト側に空ディレクトリを
# 誤作成するため）。
guard_shared_mount() {
  if [[ -n "${SHARED_MOUNT:-}" ]]; then
    SHARED_MOUNT="${SHARED_MOUNT/#\~\//$HOME/}"
    export SHARED_MOUNT
    if [[ ! -d "$SHARED_MOUNT" ]]; then
      guard_fail "ERROR: SHARED_MOUNT=$SHARED_MOUNT が見つかりません（存在しないかディレクトリではありません）。起動を中止します。" || return 1
    fi
  fi
}

# .claude-container.d/env は運用者が書く信頼入力として扱う（`claude-container#29`）。
# ただし信頼入力であっても、そのプロジェクトの env が境界に影響するキーへ実際に
# 触れているかは起動前に一覧できる方が安全なため、可視化する。値そのもの
# （ホスト固有パスを含みうる）は出力せず、キー名のみ列挙する。
guard_env_boundary_keys() {
  [[ -n "$ENV_FILE" ]] || return 0
  if grep -qE '^CLAUDE_CONTAINER_NO_FIREWALL=1[[:space:]]*$' "$ENV_FILE" 2>/dev/null; then
    guard_warn "WARNING: $ENV_FILE で CLAUDE_CONTAINER_NO_FIREWALL=1 が設定されています。エグレスファイアウォールは無効化されます。"
  fi
  local key
  local -a boundary_keys_found=()
  for key in EXTRA_MOUNT SHARED_MOUNT SECRETS_DIR GITCONFIG_FILE CODEX_DIR CLAUDE_CONFIG_DIR; do
    if grep -qE "^${key}=" "$ENV_FILE" 2>/dev/null; then
      boundary_keys_found+=("$key")
    fi
  done
  if [[ ${#boundary_keys_found[@]} -gt 0 ]]; then
    echo "INFO: $ENV_FILE が境界に影響するキーを設定しています: ${boundary_keys_found[*]}（値は表示しません。詳細は README「環境変数」節）" >&2
  fi
  return 0
}

# ベースイメージの検証（内部運用issue参照）。BASE_IMAGE は env 由来の値を
# 一切信用しない — load_env_file() の許可リスト外なので env からは export されない
# （claude-container#44）が、シェル環境から渡された値も信用しないよう、ここで無条件に
# 既定値から開始する（MCP_APPROVAL_FILE を全分岐末尾で
# 無条件 export しているのと同じ流儀）。正しい指定先は
# .claude-container.d/base-image.txt のみ。
#
# 許容範囲は docker.io の debian 公式イメージのみ（タグは自由、digest pin 可）。
# 後続のビルドレイヤー（apt/dpkg・PEP 668・uid 1000 の node ユーザー作成）が
# すべて Debian 前提のため。この制限は「セキュリティ境界」ではなく「サポート範囲の
# 宣言・互換性ガード」と位置づける — .claude-container.d/ を書き換えられる攻撃者は
# packages.txt 経由で apt の maintainer script を既にビルド時 root で実行でき、
# requirements.txt 経由の任意 PyPI 名指定でも sdist の setup.py がビルド時 root で
# 実行される経路が原理的に残る（PyPI は open publishing のため）。いずれもベース
# イメージ名だけを縛る防御効果は限定的（Codex 諮問による指摘、
# 内部運用issue参照）。タグを許可リスト化せず自由にしているのは、fail-closed
# は「恒久条件で永久に閉じ続けない逃げ道」を持つべきという設計原則のため（新しい
# Debian スイート名が出るたびに拒否され続けるゲートを作らない）。実際の互換性は
# Dockerfile.claude 側の能力アサーション（setpriv・apt sources 等）が担保する。
guard_base_image() {
  BASE_IMAGE="debian:stable"

  if [[ -n "$ENV_FILE" && -f "$ENV_FILE" ]] \
     && grep -qE '^[[:space:]]*BASE_IMAGE=' "$ENV_FILE"; then
    guard_warn "WARNING: $ENV_FILE の BASE_IMAGE=... は無視されます。正しい指定先は .claude-container.d/base-image.txt です。"
  fi

  resolve_asset_source base-image.txt
  if [[ "$ASSET_ORIGIN" == "missing" ]]; then
    [[ ${CHECK_MODE:-0} -eq 1 ]] && echo "[INFO] ベースイメージ: $BASE_IMAGE（base-image.txt なし、既定値）"
    return 0
  fi

  # 最初の有効行を読む（claude-container#50）。grep の終了コードは 0（有効行あり）／
  # 1（有効行なし）／2 以上（読めない等）で、set -e 下では 1 でも代入式ごと関数が
  # 落ちるため || で受ける。--check は guard_* を `|| true` で呼ぶので set -e が
  # 効かず、素呼びの通常起動だけが無言停止する乖離になっていた。`grep | head -1` は
  # 有効行が多いと head の早期終了で grep が SIGPIPE（rc=141）を受けるため、grep 自身が
  # 最初の一致で止まる -m1 を使う（pipefail 下で rc が grep の 0/1/2 に確定する）。
  local value grep_rc=0
  value="$(grep -m1 -vE '^[[:space:]]*(#|$)' "$ASSET_PATH" | tr -d '[:space:]')" || grep_rc=$?
  if (( grep_rc > 1 )); then
    guard_fail "ERROR: $PROJECT_CONF_DIR/base-image.txt を読めません（grep rc=$grep_rc）。起動を中止します。" || return 1
  fi
  if [[ -z "$value" ]]; then
    [[ ${CHECK_MODE:-0} -eq 1 ]] && echo "[INFO] ベースイメージ: $BASE_IMAGE（base-image.txt は空、既定値）"
    return 0
  fi

  if [[ ! "$value" =~ ^(docker\.io/(library/)?)?debian:[A-Za-z0-9][A-Za-z0-9._-]*(@sha256:[0-9a-f]{64})?$ ]]; then
    guard_fail "ERROR: $PROJECT_CONF_DIR/base-image.txt の値が許容範囲外です: $value" \
      "docker.io の debian 公式イメージのみ許可されます（タグは自由、digest pin 可）。" \
      "例: debian:testing, debian:trixie-20260701, debian:stable@sha256:<64桁hex>" || return 1
  fi

  BASE_IMAGE="$value"
  [[ ${CHECK_MODE:-0} -eq 1 ]] && echo "[INFO] ベースイメージ: $BASE_IMAGE"
  return 0
}

# MCP監査ゲートの状態判定（読み取り専用部分。内部運用issue対応で check_mcp_approval()
# から分離）。書き込み・TTY確認・export は一切行わない。--check モードの診断とTOFU承認の
# 実処理が同一ロジックを共有するために分離した。
# 迂回防止の設計:
#   - ハッシュの正規化 jq フィルタは entrypoint.sh の照合ロジックと同一でなければ
#     ならない（変更時は両ファイルを同期すること）。
compute_mcp_state() {
  MCP_STATE=""
  MCP_CURRENT_HASH=""
  MCP_STDIO_JSON=""

  if ! command -v jq >/dev/null 2>&1; then
    MCP_STATE="nojq"
    return 0
  fi

  local mcp_config="$WORKING_DIR/.mcp.json"
  if [[ ! -f "$mcp_config" ]]; then
    MCP_STATE="nofile"
    return 0
  fi

  local stdio_json
  if ! stdio_json=$(jq -S -c '[(.mcpServers // {}) | to_entries[] | select(.value.command != null)]' "$mcp_config" 2>/dev/null); then
    MCP_STATE="parsefail"
    return 0
  fi

  if [[ "$stdio_json" == "[]" ]]; then
    MCP_STATE="none"
    return 0
  fi

  local current_hash recorded_hash=""
  # entrypoint.sh 側は `jq ... | sha256sum`（jqの出力に末尾改行あり）で直接計算するため、
  # ここも printf '%s\n' で末尾改行を復元してから計算する（'%s' だと $() の改行除去により
  # 同一入力でも異なるハッシュになり、TOFU照合が常に不一致になるバグを検証中に発見した）。
  current_hash=$(printf '%s\n' "$stdio_json" | sha256sum | cut -c1-64)
  if [[ -f "$MCP_APPROVAL_RECORD" ]]; then
    recorded_hash=$(cat "$MCP_APPROVAL_RECORD" 2>/dev/null || echo "")
  fi

  MCP_CURRENT_HASH="$current_hash"
  MCP_STDIO_JSON="$stdio_json"
  if [[ -n "$recorded_hash" && "$recorded_hash" == "$current_hash" ]]; then
    MCP_STATE="approved"
  else
    MCP_STATE="pending"
  fi
}

# MCP監査ゲートのTOFU（Trust On First Use）＋変更検知（claude-container#28）。
# .mcp.json のstdio型サーバー定義（entrypoint.sh側のTTY確認対象）が前回承認時から
# 変化していなければ、承認記録のハッシュをコンテナへ渡して entrypoint.sh 側の
# TTY確認をスキップさせる。不一致・記録なしの場合はここで（-b のビルドより前に）
# TTY確認を行い、拒否時の無駄なビルドを避ける。
#
# 迂回防止の設計:
#   - 承認記録の格納パス（MCP_APPROVAL_STORE/RECORD）は load_env_file() より前に
#     $HOME から直接算出し readonly にしてある。プロジェクト側 env が同名キーを
#     書いても無視され警告が出る（claude-container#39）。
#   - MCP_APPROVAL_FILE は本関数の全分岐の末尾で必ず export する。呼び出し元
#     （compose.yml の ${MCP_APPROVAL_FILE:-/dev/null}）は env 経由の値を一切
#     参照しないため、プロジェクト側が env に MCP_APPROVAL_FILE を書いても無視される。
#   - 記録ファイルは compose.yml 側で :ro マウントする。コンテナ内から改変不可。
check_mcp_approval() {
  MCP_APPROVAL_FILE=""
  compute_mcp_state

  case "$MCP_STATE" in
    nojq | nofile | none)
      export MCP_APPROVAL_FILE
      return 0
      ;;
    parsefail)
      echo "WARNING: $WORKING_DIR/.mcp.json の解析に失敗しました。事前承認をスキップします（コンテナ内のMCP監査ゲートが起動可否を判定します）。" >&2
      export MCP_APPROVAL_FILE
      return 0
      ;;
    approved)
      echo "INFO: MCP 監査: stdio 型サーバーは承認済み（ハッシュ一致）。確認を省略します" >&2
      MCP_APPROVAL_FILE="$MCP_APPROVAL_RECORD"
      export MCP_APPROVAL_FILE
      return 0
      ;;
    pending)
      echo "WARNING: $WORKING_DIR/.mcp.json の stdio 型 MCP サーバーの定義が前回の承認から変わっている（または未承認の）ものがあります。そのコードはセッション開始時に即座に実行され、export された全ての秘密を読めます:" >&2
      # .mcp.json はプロジェクト側リポジトリの一部で攻撃者が制御しうるため、この確認プロンプトが
      # 唯一の人間ゲートになる。制御文字（ANSIエスケープ等）を除去してからでないと、表示を偽装する
      # 「ターミナル・スプーフィング」に無防備になる（claude-container#35）。entrypoint.sh 側の同種の
      # 表示ロジックと同一のサニタイズ方式（LC_ALL=C tr -d '\000-\037\177'）を使うこと（同期必須）。
      echo "$MCP_STDIO_JSON" | jq -r '.[] | "  - \(.key): \(.value.command) \((.value.args // []) | join(" "))"' | LC_ALL=C tr -d '\000-\037\177' >&2
      printf 'これらの MCP サーバーの起動を許可し、この承認を記憶しますか? [y/N] ' >&2
      local mcp_confirm=""
      if ! read -r mcp_confirm </dev/tty 2>/dev/null; then
        echo "INFO: 対話可能な TTY がないため、確認はコンテナ内の MCP 監査ゲートに委ねます。" >&2
        export MCP_APPROVAL_FILE
        return 0
      fi
      case "$mcp_confirm" in
        y | Y | yes | YES | Yes)
          mkdir -p "$MCP_APPROVAL_STORE"
          chmod 700 "$MCP_APPROVAL_STORE"
          printf '%s' "$MCP_CURRENT_HASH" > "$MCP_APPROVAL_RECORD"
          chmod 600 "$MCP_APPROVAL_RECORD"
          MCP_APPROVAL_FILE="$MCP_APPROVAL_RECORD"
          export MCP_APPROVAL_FILE
          ;;
        *)
          echo "ERROR: MCP stdio 型サーバーの確認が拒否されました。起動を中止します" >&2
          exit 1
          ;;
      esac
      ;;
  esac
}

# 境界アセット・ビルド時設定ファイルの解決規則（`claude-container#30`）。2種類ある:
#   - fixed:       常に $RUN_DIR 固定。プロジェクト側で上書き不可
#                  （entrypoint.sh・init-firewall.sh・git-askpass.sh・Dockerfile.claude・
#                    validate-build-input.sh）
#   - overridable: $PROJECT_CONF_DIR にあればそちらを、無ければ $RUN_DIR の同梱デフォルトを使う
#                  （packages.txt・requirements.txt・allowed-domains.txt）
#   - optional:    $PROJECT_CONF_DIR にあればそちらを、無ければ「なし」（同梱デフォルトを持たない）
#                  （node-version.txt・codex-version.txt・allowed-ports.txt）
# stage_build_context() と compute_asset_hash() の双方がこの関数を通すことで、
# 2箇所が別々に解決規則を持ってドリフトするのを防ぐ。副作用は持たない（WARNING等の出力は
# 呼び出し側が ASSET_ORIGIN を見て行う）。
resolve_asset_source() {
  local name="$1"
  ASSET_PATH=""
  ASSET_ORIGIN=""
  case "$name" in
    entrypoint.sh | init-firewall.sh | git-askpass.sh | Dockerfile.claude | validate-build-input.sh | ipv6-firewall.py | compose.ipv6.yml | compose.plugins-alias.yml)
      ASSET_PATH="$RUN_DIR/$name"
      ASSET_ORIGIN="fixed"
      ;;
    packages.txt | requirements.txt | allowed-domains.txt)
      if [[ -f "$PROJECT_CONF_DIR/$name" ]]; then
        ASSET_PATH="$PROJECT_CONF_DIR/$name"
        ASSET_ORIGIN="project"
      else
        ASSET_PATH="$RUN_DIR/$name"
        ASSET_ORIGIN="default"
      fi
      ;;
    node-version.txt | codex-version.txt | allowed-ports.txt | base-image.txt)
      if [[ -f "$PROJECT_CONF_DIR/$name" ]]; then
        ASSET_PATH="$PROJECT_CONF_DIR/$name"
        ASSET_ORIGIN="project"
      else
        ASSET_ORIGIN="missing"
      fi
      ;;
    *)
      echo "ERROR: resolve_asset_source: 未知のアセット名です: $name" >&2
      exit 1
      ;;
  esac
}

# 境界アセットのドリフト検知（`claude-container#30`）対象。固定順の配列で持つ
# （glob 順序はロケール・実装依存で非決定的なため）。github-meta.json は毎ビルド
# 変わるため意図的に対象外（含めると恒久的にドリフトした状態になってしまう）。
ASSET_HASH_TARGETS=(
  entrypoint.sh
  init-firewall.sh
  ipv6-firewall.py
  compose.ipv6.yml
  compose.plugins-alias.yml
  git-askpass.sh
  Dockerfile.claude
  validate-build-input.sh
  packages.txt
  requirements.txt
  allowed-domains.txt
  node-version.txt
  codex-version.txt
  allowed-ports.txt
  base-image.txt
)
# env の同名 export は配列の要素0へ代入されドリフト検知対象を偽装できるため readonly（claude-container#39）
readonly -a ASSET_HASH_TARGETS

# 対象アセットの内容のみをハッシュする（sha256sum "$file" ではなくリダイレクトで
# 読ませる — 前者は出力にパスを含むため、同一内容のリポジトリを別パスへ clone
# しただけで誤警告になる）。失敗時は空文字でなく非ゼロで返す。空文字を返すと
# 「ラベル未設定の旧イメージ」（inspect が返す空文字列）と区別が付かなくなり、
# 計算失敗が「一致」と誤判定されてしまうため。
compute_asset_hash() {
  ASSET_HASH=""
  local name content_hash combined=""
  for name in "${ASSET_HASH_TARGETS[@]}"; do
    resolve_asset_source "$name"
    if [[ "$ASSET_ORIGIN" == "missing" ]]; then
      content_hash=$(printf '' | sha256sum | cut -d' ' -f1)
    elif ! content_hash=$(sha256sum < "$ASSET_PATH" 2>/dev/null | cut -d' ' -f1) || [[ -z "$content_hash" ]]; then
      echo "ERROR: compute_asset_hash: $name（$ASSET_PATH）のハッシュ計算に失敗しました" >&2
      return 1
    fi
    combined+="${name}:${content_hash}"$'\n'
  done
  ASSET_HASH=$(printf '%s' "$combined" | sha256sum | cut -d' ' -f1)
}

# entrypoint.sh / init-firewall.sh / git-askpass.sh / validate-build-input.sh（fixed）・
# packages.txt / requirements.txt / allowed-domains.txt（overridable）・
# node-version.txt / codex-version.txt / allowed-ports.txt（optional）を
# ビルドコンテキストへ集約する。packages.txt・requirements.txt・allowed-domains.txt は
# プロジェクト側の .claude-container.d/ にあればそちらを、
# なければ claude-container 同梱のデフォルト（空のフォールバック）を使う。
# node-version.txt・codex-version.txt・allowed-ports.txt は無ければ静かに空ファイルを生成する。
# 注意: .claude-container.d/env（ランタイム設定、ホスト固有パスを含みうる）はこのリストに
# 意図的に含めない。イメージへ焼き込んではならないため（下記アサーション参照）。
stage_build_context() {
  mkdir -p "$BUILD_CONTEXT_DIR"

  local name
  for name in entrypoint.sh init-firewall.sh ipv6-firewall.py git-askpass.sh validate-build-input.sh; do
    resolve_asset_source "$name"
    cp "$ASSET_PATH" "$BUILD_CONTEXT_DIR/$name"
  done

  for name in packages.txt requirements.txt allowed-domains.txt; do
    resolve_asset_source "$name"
    if [[ "$ASSET_ORIGIN" == "default" ]]; then
      # .claude-container.d/ 側の設定が無いプロジェクトは汎用の空フォールバックに
      # 静かに切り替わる。かつて claude-container 本体の packages.txt に直接
      # 書かれていたプロジェクト固有パッケージ（gcc/python3等）が、汎用化リファクタ
      # リング（2026-07-01）後に .claude-container.d/ へ移行されないまま消失した
      # 実障害（python3-missing インシデント、2026-07-02）があるため、フォール
      # バック使用時は必ず気づけるよう警告を出す。
      echo "WARNING: $PROJECT_CONF_DIR/$name がありません。claude-container 同梱の空のフォールバック（$name）を使います。このプロジェクトでパッケージやドメインが必要なら .claude-container.d/$name を作成してください。" >&2
    fi
    cp "$ASSET_PATH" "$BUILD_CONTEXT_DIR/$name"
  done

  # node-version.txt / codex-version.txt / allowed-ports.txt は上記3ファイルとは
  # 別扱い: いずれも新設の任意機能であり、移行元が存在しない（= 無いのが正常な
  # 大多数のプロジェクト向けに WARNING を出すとノイズになるだけ）ため、無ければ
  # 静かに空ファイルを生成する。既存3ファイルの WARNING 設計自体を見直すかどうかは
  # 別 issue で扱う。allowed-ports.txt の空の意味（既定値 443,22 の適用）は
  # init-firewall.sh 自身が解釈する（`claude-container#31`）。
  for name in node-version.txt codex-version.txt allowed-ports.txt; do
    resolve_asset_source "$name"
    if [[ "$ASSET_ORIGIN" == "missing" ]]; then
      : > "$BUILD_CONTEXT_DIR/$name"
    else
      cp "$ASSET_PATH" "$BUILD_CONTEXT_DIR/$name"
    fi
  done

  # base-image.txt は意図的にここでステージしない（内部運用issue参照）。他の
  # optional ファイルと違い、Dockerfile.claude の FROM は COPY より先に評価されるため
  # ビルドコンテキストへ置いても読めない。値は guard_base_image() がホスト側で検証し、
  # build arg（BASE_IMAGE）として compose 経由で渡す。resolve_asset_source() と
  # ASSET_HASH_TARGETS には登録済み（ドリフト検知・--check 診断の対象にするため）。

  # 防御的アサーション: env（ランタイム設定）が万一ビルドコンテキストに紛れ込んでいたら
  # 即座にビルドを止める。将来上記ループがワイルドカードコピーに書き換えられた場合の
  # リグレッション（ホスト固有パスのイメージ焼き込み）を防ぐための安全網。
  if [[ -e "$BUILD_CONTEXT_DIR/env" ]]; then
    echo "ERROR: env がビルドコンテキストに紛れ込んでいます（ランタイム設定はビルド時に焼き込まない設計です）。stage_build_context() の実装を確認してください。" >&2
    exit 1
  fi

  # GitHub meta スナップショット。init-firewall.sh のファイアウォール許可リストが使う
  # GitHub IP レンジの取得元。未認証 GitHub API のレート制限（60 req/h/IP）を消費するのは
  # ここ1箇所のみ（起動時にはライブ取得しない）。失敗時は (1) このプロジェクトの前回
  # ステージング分（.build-context/<project>/ は --clean まで永続する）、(2) それも無ければ
  # 他プロジェクトの最新スナップショット（GitHub IP レンジは変更頻度が低いため実用上問題ない）
  # を警告付きで再利用し、いずれも無ければビルドを止める。
  local gh_meta sibling
  # shellcheck disable=SC2012 # ls は下の elif のみ。パスは PROJECT_NAME（サニタイズ済み）+ 固定ファイル名のみで空白・改行を含まない
  if gh_meta=$(curl -fsS https://api.github.com/meta) \
     && echo "$gh_meta" | jq -e '.web and .api and .git' >/dev/null 2>&1; then
    echo "$gh_meta" > "$BUILD_CONTEXT_DIR/github-meta.json"
  elif [[ -f "$BUILD_CONTEXT_DIR/github-meta.json" ]]; then
    echo "WARNING: GitHub meta の取得に失敗しました（レート制限の可能性）。前回ステージングしたスナップショットを再利用します" >&2
  elif sibling=$(ls -t "$RUN_DIR"/.build-context/*/github-meta.json 2>/dev/null | head -1) && [[ -n "$sibling" ]]; then
    echo "WARNING: GitHub meta の取得に失敗し、このプロジェクトのスナップショットもありません。別プロジェクトのスナップショットを再利用します（$sibling）" >&2
    cp "$sibling" "$BUILD_CONTEXT_DIR/github-meta.json"
  else
    echo "ERROR: GitHub meta を取得できず、過去のスナップショットもありません（レート制限の可能性。解除後に再試行してください）" >&2
    exit 1
  fi
}

# 境界アセットのドリフト検知（`claude-container#30`）。通常起動時・--check の
# 両方から呼ぶ（IMAGE_NAME は compute_project_name()、PROJECT_CONF_DIR は
# freeze_project_paths() が先に設定している前提）。fail-open: 不一致は guard_warn
# に留め、起動は止めない。理由: ドリフトは「古いが過去に承認された状態」であって
# 進行中の攻撃ではない。fail-closed にすると claude-container 自身をセルフホストで
# 開発する際（本リポジトリを編集した瞬間に必ずドリフトする）に起動できなくなり、
# 警告以上の安全性の利得なく開発フローを壊す。
guard_asset_drift() {
  if ! command -v podman >/dev/null 2>&1; then
    return 0
  fi
  if ! podman image exists "$IMAGE_NAME" 2>/dev/null; then
    return 0
  fi
  local recorded_hash recorded_base_image
  recorded_hash=$(podman image inspect --format '{{index .Labels "claude-container.asset-hash"}}' "$IMAGE_NAME" 2>/dev/null || true)
  recorded_base_image=$(podman image inspect --format '{{index .Labels "claude-container.base-image"}}' "$IMAGE_NAME" 2>/dev/null || true)
  if ! compute_asset_hash; then
    guard_warn "WARNING: 境界アセットのハッシュ計算に失敗したため、ドリフト確認をスキップしました。"
    return 0
  fi
  if [[ -z "$recorded_hash" ]]; then
    guard_warn "WARNING: イメージ $IMAGE_NAME に境界アセットのハッシュラベルがありません（このドリフト検知機能の導入前にビルドされたイメージです）。-b でのリビルドを推奨します。"
  elif [[ "$recorded_hash" != "$ASSET_HASH" ]]; then
    guard_warn "WARNING: 境界アセット（entrypoint.sh・init-firewall.sh 等）がイメージのビルド後に変更されています。-b でのリビルドを推奨します。"
  fi
  # base-image.txt を変更 → -b → 元の値に戻して -b 忘れ、という順序では
  # compute_asset_hash() の内容ハッシュが一致してしまい上記の比較では検知できない。
  # 実ビルド値を記録したラベル（Dockerfile.claude の claude-container.base-image）と
  # 現在の解決結果 $BASE_IMAGE（guard_base_image() が先に設定している前提）を
  # 直接比較することで、この場合も検知する。
  if [[ -n "$recorded_base_image" && -n "${BASE_IMAGE:-}" && "$recorded_base_image" != "$BASE_IMAGE" ]]; then
    guard_warn "WARNING: ベースイメージの設定（$BASE_IMAGE）が、イメージの実ビルド値（$recorded_base_image）と異なります。-b でのリビルドを推奨します。"
  fi
  return 0
}

# --check モード（内部運用issue参照）。1プロジェクトを診断する。呼び出し元
# （run_check_mode）がサブシェル内で呼ぶことを前提とする（`local` の効かない
# グローバル変数の書き換え — WORKING_DIR・PROJECT_NAME・ENV_FILE 等 — がこの
# プロセス内に閉じ、他プロジェクトの診断や親シェルの状態を汚染しないため）。
check_one_project() {
  set -e
  CHECK_MODE=1
  CHECK_HAS_ERROR=0
  CHECK_HAS_WARN=0
  COMPOSE_OVERRIDE_ARGS=()
  # env が CHECK_MODE=0 を書くと guard_warn が CHECK_HAS_WARN を立てなくなる（claude-container#39）
  readonly CHECK_MODE
  local dir="$1" from_ledger="$2"

  if ! WORKING_DIR=$(cd "$dir" 2>/dev/null && pwd); then
    echo "[FAIL] ディレクトリが存在しません: $dir"
    if [[ "$from_ledger" -eq 1 ]]; then
      echo "  (起動台帳に記録がありますが実体が見つかりません。不要なら $CC_LEDGER_FILE を手動編集してください)"
    fi
    return 20
  fi
  readonly WORKING_DIR
  cd "$WORKING_DIR"
  echo "[OK]   プロジェクトディレクトリ実在: $WORKING_DIR"

  compute_project_name
  echo "  PROJECT_NAME: $PROJECT_NAME"
  freeze_project_paths

  ENV_FILE=""
  if [[ -f "$PROJECT_CONF_DIR/env" ]]; then
    ENV_FILE="$PROJECT_CONF_DIR/env"
    # readonly は「最後の書き込みの後」かつ「load_env_file() より前」に置く（claude-container#39）。
    # この経路は load_env_file が if ブロックの内側にあるため、ブロックの外へ出すと load の後になり
    # --check だけ env の上書きを素通しする。else 分岐は load を呼ばないため露出しない。
    readonly ENV_FILE
    echo "[OK]   .claude-container.d/env あり"
    load_env_file "$ENV_FILE"
  else
    echo "[INFO] .claude-container.d/env なし（ランタイム設定なしで起動されます）"
  fi

  guard_env_gh_token || true
  guard_legacy_vars || true
  guard_gitconfig_file || true
  guard_secrets_dir || true
  guard_codex_dir || true
  guard_shared_mount || true
  guard_env_boundary_keys || true
  guard_base_image || true
  guard_ipv6 || true
  prepare_claude_config_ro || true
  guard_plugins_alias || true

  local file
  local vbi_path vbi_target vbi_kind vbi_rc
  for file in packages.txt requirements.txt allowed-domains.txt; do
    if [[ -f "$PROJECT_CONF_DIR/$file" ]]; then
      echo "[OK]   $file: プロジェクト側設定あり"
    else
      CHECK_HAS_WARN=1
      echo "[WARN] WARNING: $PROJECT_CONF_DIR/$file がありません。claude-container 同梱の空のフォールバック（$file）を使います。このプロジェクトでパッケージやドメインが必要なら .claude-container.d/$file を作成してください。"
    fi

    # packages.txt/requirements.txt の内容診断（validate-build-input.sh を
    # outfile なしで dry-run 呼び出し）。allowed-domains.txt はスコープ外
    # （ドメイン名に packages 用 regex を当てると誤検知するため、claude-container#34）。
    # スクリプトのパスは resolve_asset_source() の fixed 解決（RUN_DIR 起点）を使う
    # — check_one_project() は上で $WORKING_DIR（利用側プロジェクトのルート）へ
    # cd 済みのため、相対パスで呼ぶと利用側の同名ファイルが実行され fixed の意味が消える。
    # 終了コードの解釈は validate-build-input.sh の契約（中核設計2）に一本化し、
    # --check 側で grep 等の終了コードを独自に解釈しない。
    case "$file" in
      packages.txt | requirements.txt)
        resolve_asset_source "validate-build-input.sh"
        vbi_path="$ASSET_PATH"
        resolve_asset_source "$file"
        vbi_target="$ASSET_PATH"
        vbi_kind="${file%.txt}"
        # set -e 下で validate-build-input.sh は正常時（不正行なし）以外に
        # rc 1/2 を返しうるため、必ず || で握る（素の "; rc=$?" は set -e により
        # 到達前にシェルが終了する）。
        vbi_rc=0
        sh "$vbi_path" "$vbi_kind" "$vbi_target" || vbi_rc=$?
        case "$vbi_rc" in
          0) echo "[OK]   $file: 内容診断 OK" ;;
          1) guard_warn "[WARN] $file に仕様外の行があります（詳細は上記の標準エラー出力を参照）" ;;
          2) guard_warn "[WARN] $file の内容診断ができませんでした" ;;
          *) guard_warn "[WARN] $file の内容診断ができませんでした（終了コード: $vbi_rc）" ;;
        esac
        ;;
    esac
  done

  if ! command -v podman >/dev/null 2>&1; then
    echo "[SKIP] podman が見つからないためイメージ確認をスキップ"
  elif podman image exists "$IMAGE_NAME" 2>/dev/null; then
    echo "[OK]   イメージ既ビルド: $IMAGE_NAME"
  else
    echo "[INFO] イメージ未ビルド: $IMAGE_NAME（初回起動時に自動ビルドされます。破壊的変更後は -b を推奨）"
  fi

  guard_asset_drift || true

  compute_mcp_state
  case "$MCP_STATE" in
    nojq)
      echo "[SKIP] jq が見つからないため MCP 監査ゲートの事前承認確認をスキップ"
      ;;
    nofile | none)
      echo "[OK]   MCP監査ゲート: 対象の stdio 型サーバーなし"
      ;;
    parsefail)
      CHECK_HAS_WARN=1
      echo "[WARN] WARNING: $WORKING_DIR/.mcp.json の解析に失敗しました。"
      ;;
    approved)
      echo "[OK]   MCP監査ゲート: stdio 型サーバー承認済み（ハッシュ一致）"
      ;;
    pending)
      echo "[INFO] MCP監査ゲート: stdio 型サーバーが未承認/変更あり。初回起動時に確認プロンプトが出ます"
      ;;
  esac

  if [[ $CHECK_HAS_ERROR -eq 1 ]]; then
    echo "→ 結果: FAIL"
    return 20
  elif [[ $CHECK_HAS_WARN -eq 1 ]]; then
    echo "→ 結果: WARN"
    return 10
  else
    echo "→ 結果: PASS"
    return 0
  fi
}

# --check のドライバ。引数があれば各ディレクトリを、なければ起動台帳
# （$CC_LEDGER_FILE）の全プロジェクトを診断する。非対話。対象リポジトリと
# `.build-context/` は変更しない（`/tmp` の一時ファイルは除く）。
run_check_mode() {
  local -a targets=()
  local -a from_ledger_flags=()
  if [[ $# -gt 0 ]]; then
    local d
    for d in "$@"; do
      targets+=("$d")
      from_ledger_flags+=(0)
    done
  else
    if [[ ! -s "$CC_LEDGER_FILE" ]]; then
      echo "起動台帳が空です（$CC_LEDGER_FILE）。まだ通常起動が記録されていません。--check <directory> で個別指定できます。"
      return 0
    fi
    local line
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ -n "$line" ]] || continue
      targets+=("$line")
      from_ledger_flags+=(1)
    done < "$CC_LEDGER_FILE"
  fi

  local pass=0 warn=0 fail=0
  local -a fail_names=()
  local i dir from_ledger rc
  for i in "${!targets[@]}"; do
    dir="${targets[$i]}"
    from_ledger="${from_ledger_flags[$i]}"
    echo "=== $dir ==="
    set +e
    ( check_one_project "$dir" "$from_ledger" ) 2>&1
    rc=$?
    set -e
    case "$rc" in
      0) pass=$((pass + 1)) ;;
      10) warn=$((warn + 1)) ;;
      20) fail=$((fail + 1)); fail_names+=("$dir") ;;
      *) fail=$((fail + 1)); fail_names+=("$dir (unexpected exit $rc)") ;;
    esac
    echo
  done

  echo "==== サマリ ===="
  echo "検査対象: ${#targets[@]} プロジェクト（起動台帳: $CC_LEDGER_FILE）"
  echo "PASS: $pass   WARN: $warn   FAIL: $fail"
  if [[ ${#fail_names[@]} -gt 0 ]]; then
    echo "リビルド前に対応が必要:"
    local n
    for n in "${fail_names[@]}"; do
      echo "  - $n"
    done
    return 1
  fi
  return 0
}

# ============================================================
# dispatch（トップレベル実行文。相対順序は関数化前と同一に保つ）
# ============================================================

set -- ${POSITIONAL_ARGS[@]+"${POSITIONAL_ARGS[@]}"}

# --clean をディレクトリ引数なしで呼んだ場合は全プロジェクト分を削除して終了
if [[ $CLEAN -eq 1 && $# -eq 0 ]]; then
  clean_all
  exit 0
fi

# --check（内部運用issue参照）: 引数なしでも起動台帳を全件診断できる必要が
# あるため、「引数なし→usage」判定より前で dispatch する。
if [[ $CHECK -eq 1 ]]; then
  run_check_mode ${POSITIONAL_ARGS[@]+"${POSITIONAL_ARGS[@]}"}
  exit $?
fi

if [[ $# -eq 0 ]]; then
  usage
  exit 1
fi

echo "RUN DIR: $RUN_DIR"

resolve_project_directory "$1"
readonly WORKING_DIR

compute_project_name
echo "PROJECT: $PROJECT_NAME"

freeze_project_paths

# --clean <directory>: このプロジェクト分のみ削除して終了
if [[ $CLEAN -eq 1 ]]; then
  clean_project
  exit 0
fi

cd -- "$WORKING_DIR" 2>/dev/null || guard_fail "ERROR: ディレクトリを開けません: $WORKING_DIR" \
  "パスが存在するディレクトリか、アクセス権があるかを確認してください。"

record_project_in_ledger

ENV_FILE=""
if [[ -f "$PROJECT_CONF_DIR/env" ]]; then
  ENV_FILE="$PROJECT_CONF_DIR/env"
fi
# readonly は「最後の書き込みの後」かつ「load_env_file() より前」に置く（claude-container#39）。
# この2行を load の後ろへ動かすと、env が ENV_FILE/CHECK_MODE を上書きしてガードを沈黙させられる。
readonly ENV_FILE
readonly CHECK_MODE
[[ -n "$ENV_FILE" ]] && load_env_file "$ENV_FILE"

guard_env_gh_token
guard_legacy_vars
guard_gitconfig_file
guard_secrets_dir
guard_codex_dir
guard_shared_mount
guard_env_boundary_keys
guard_base_image
guard_ipv6
guard_asset_drift

check_mcp_approval

# 全 guard と MCP 承認を通った後にだけホスト ~/.claude へ placeholder を作る
# （起動を拒否する経路ではホストに何も書かない）。
prepare_claude_config_ro
guard_plugins_alias

# compose がビルドコンテキストとして参照するため、ディレクトリ自体は常に存在させる
mkdir -p "$BUILD_CONTEXT_DIR"

# -b 指定時、またはイメージが未ビルドのときのみステージングを実行する
# （podman image exists が使えない古い podman では `podman images -q` ベースの判定に読み替える）
if [[ $BUILD -eq 1 ]] || ! podman image exists "$IMAGE_NAME" 2>/dev/null; then
  stage_build_context
fi

# 境界アセットのハッシュ（`claude-container#30`）。ビルドの有無に関わらず常に
# 現在のソース（$RUN_DIR・$PROJECT_CONF_DIR）から計算し、build と run 両方の env
# プレフィックスへ渡す（下記）。build ブロック内だけに限定すると、-b 無しの初回
# 起動（compose の暗黙ビルド）でラベルが空になり、直後の通常起動で必ず誤警告が出る。
if ! compute_asset_hash; then
  echo "ERROR: 境界アセットのハッシュを計算できませんでした。起動を中止します" >&2
  exit 1
fi

# ホストのタイムゾーンを自動検出（.claude-container.d/env またはシェル環境で TZ が設定済みでなければ）
if [[ -z "${TZ:-}" ]]; then
  if [[ -f /etc/timezone ]]; then
    TZ=$(cat /etc/timezone)
  elif [[ -L /etc/localtime ]]; then
    TZ=$(readlink /etc/localtime | sed 's|.*/zoneinfo/||')
  else
    TZ=UTC
  fi
  export TZ
fi

# -b のビルドは run と分離して実行する。`run --build` はビルド失敗時に
# 既存の古いイメージでそのまま起動してしまう（fail-open）ため、
# build を独立させ set -e で失敗時に起動へ進ませないようにする（fail-closed）。
if [[ $BUILD -eq 1 ]]; then
  # codex-version.txt が "latest" のプロジェクトだけ Codex レイヤーのキャッシュを
  # 破棄する（Dockerfile.claude の ARG CODEX_CACHEBUST 参照箇所と対）。固定バージョン
  # 指定・未使用（空ファイル）のプロジェクトは "pinned" のまま変えず、既存のビルド
  # キャッシュ効率を壊さない。
  CODEX_CACHEBUST=pinned
  if [[ -f "$BUILD_CONTEXT_DIR/codex-version.txt" ]] \
     && [[ "$(tr -d '[:space:]' < "$BUILD_CONTEXT_DIR/codex-version.txt")" == "latest" ]]; then
    CODEX_CACHEBUST="$(date +%s)"
  fi
  CACHEBUST="$(date +%s)" CODEX_CACHEBUST="$CODEX_CACHEBUST" ASSET_HASH="$ASSET_HASH" BASE_IMAGE="$BASE_IMAGE" CONTEXT="$WORKING_DIR" CLAUDE_CONTAINER_DIR="$RUN_DIR" \
    podman compose -f "$RUN_DIR/compose.yml" "${COMPOSE_OVERRIDE_ARGS[@]}" -p "$PROJECT_NAME" --in-pod false --env-file /dev/null build claude-auth-workspace
fi

# BASE_IMAGE は build 側だけでなくここ（run 側）にも渡す。-b なしの初回起動は
# compose の暗黙ビルドで焼かれるため、run 側に渡し忘れると初回だけ既定値でビルド
# され、以後 -b するまで設定が効かないという無言バグになる（ASSET_HASH を両方に
# 渡している理由と同型）。
#
# --env-file /dev/null は、podman-compose が既定で読む compose ディレクトリと
# カレントディレクトリ（＝対象プロジェクト）の .env を補間に使わせないため（claude-container#60）。
# リポジトリ同梱の .env が CODEX_DIR・EXTRA_MOUNT・CLAUDE_CONTAINER_NO_FIREWALL 等を
# 全ガード素通りで設定できていた。ランタイム設定の入口は .claude-container.d/env だけにする。
# dotenv_to_dict() は通常ファイルでないパスに空辞書を返し、引数が ".env" でなければ
# compose ディレクトリ側も読まれない（podman-compose 1.6.0 で実測）。build 側にも同じ理由で付ける。
CONTEXT="$WORKING_DIR" CLAUDE_CONTAINER_DIR="$RUN_DIR" ASSET_HASH="$ASSET_HASH" BASE_IMAGE="$BASE_IMAGE" \
  podman compose -f "$RUN_DIR/compose.yml" "${COMPOSE_OVERRIDE_ARGS[@]}" -p "$PROJECT_NAME" --in-pod false --env-file /dev/null run --rm claude-auth-workspace
