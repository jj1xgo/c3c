iptables -F
iptables -X
iptables -t nat -F
iptables -t nat -X
iptables -t mangle -F
iptables -t mangle -X
iptables -N CLAUDE_EGRESS
iptables -A INPUT -i lo -j ACCEPT
iptables -A OUTPUT -o lo -j ACCEPT
iptables -A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT
iptables -A OUTPUT -m state --state ESTABLISHED,RELATED -j ACCEPT
iptables -A OUTPUT -d 10.88.0.53 -p udp --dport 53 -j ACCEPT
iptables -A OUTPUT -d 10.88.0.53 -p tcp --dport 53 -j ACCEPT
prepare --ports 443,22
rc=1
